<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Per-user package. UpgradeCode stays fixed so later builds replace this one.
    WiX 5 is the last release before the Open Source Maintenance Fee.
  -->
  <Package
      Name="Writ"
      Manufacturer="bfcreek"
      Version="$(var.MsiVersion)"
      UpgradeCode="{A7C3E1B2-4F58-4D6A-9C21-8E5B0D4F6A17}"
      Scope="perUser"
      Language="1033">

    <MajorUpgrade
        Schedule="afterInstallInitialize"
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Writ is already installed." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Writ">
        <Component Id="WritExecutable" Guid="{B2E4F6A8-1C3D-4E5F-8A90-7B6C5D4E3F21}">
          <File Id="WritExe" Source="payload/writ.exe" />
          <RegistryValue
              Root="HKCU"
              Key="Software\bfcreek\Writ"
              Name="InstallDir"
              Type="string"
              Value="[INSTALLFOLDER]"
              KeyPath="yes" />
          <RegistryValue
              Root="HKCU"
              Key="Software\bfcreek\Writ"
              Name="Version"
              Type="string"
              Value="$(var.PackageVersion)" />
          <RemoveFolder Id="RemoveWritFolder" On="uninstall" />
          <Environment
              Id="WritPath"
              Name="PATH"
              Value="[INSTALLFOLDER]"
              Action="set"
              Part="last"
              System="no" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      The runtime module is shared by every generated script.
      ~/.writ stays, because constraints and MCP defaults live there too.
    -->
    <Directory Id="UserProfileDir" Name="UserProfile">
      <Directory Id="WritHome" Name=".writ">
        <Directory Id="WritModules" Name="modules">
          <Directory Id="WritModuleDir" Name="Writ">
            <Component Id="WritRuntimeModule" Guid="{C4D8E2A1-6B7F-4A93-9E15-2F0C8D7B6A54}">
              <File Id="WritPsm1" Source="payload/Writ.psm1" />
              <RegistryValue
                  Root="HKCU"
                  Key="Software\bfcreek\Writ"
                  Name="ModuleDir"
                  Type="string"
                  Value="[WritModuleDir]"
                  KeyPath="yes" />
              <RemoveFolder Id="RemoveWritModuleDir" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>
    <SetDirectory Id="UserProfileDir" Value="[%USERPROFILE]" />
  </Package>
</Wix>
