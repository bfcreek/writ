<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Writ.Cli</RootNamespace>
    <AssemblyName>writ</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>writ</ToolCommandName>
    <Authors>bfcreek</Authors>
    <PackageId>Writ.Cli</PackageId>
    <Description>English sentences compiled to typed operations and a PowerShell script.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/bfcreek/writ</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Writ.Compiler\Writ.Compiler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

</Project>
