        increase the score
    if (nothing otherwise 7) is equal to 7
        increase the score
    if 1 is equal to 1 and then 2 is equal to 2
        increase the score
    # or else follows the command: a false value still succeeded, so the rest does not run
    the chosen is (1 is equal to 0 or else 1 is equal to 1)
    if the chosen is equal to false
        increase the score
    if ("ab" times 3) is equal to "ababab"
        increase the score
    if (the length of ("a,b" split on ",")) is equal to 2
        increase the score
    the letters are a list containing "a" and "b"
    if (the letters joined by "-") is equal to "a-b"
        increase the score
    if ("a-b" replacing "-" with "") is equal to "ab"
        increase the score
    the pattern is "{" plus "0" plus "}" plus "-" plus "{" plus "1" plus "}"
    if (the pattern formatted with "a" and "b") is equal to "a-b"
        increase the score
