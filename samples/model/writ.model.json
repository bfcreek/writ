{
  // The named profile in "use" is the model check, compile, and run will call.
  // --model <name> selects a different one for that command.
  // A secret stays in the environment; apiKeyEnv names the variable.
  "use": "innate",
  "models": {
    "innate": { "provider": "innate" },
    "ollama": {
      "provider": "ollama",
      "model": "qwen2.5-coder"
    },
    "openai": {
      "provider": "openai",
      "model": "gpt-4.1-mini"
    },
    "copilot": {
      "provider": "copilot",
      "model": "gpt-4o"
    },
    "compatible": {
      "provider": "compatible",
      "model": "local-model",
      "endpoint": "http://127.0.0.1:1234/v1",
      "apiKeyEnv": "LOCAL_API_KEY"
    }
  }
}
